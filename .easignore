# EAS Build ignore file
# Exclude unnecessary files from the build

# Documentation
*.md
!README.md

# Tests
**/__tests__/**
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
jest.config.js
coverage/

# Development files
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (will be set via EAS)
.env
.env.*

# Cache directories
.expo/
.cache/
dist/

# OS files
.DS_Store
Thumbs.db

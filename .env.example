EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps SDK API Key (Required for react-native-maps rendering engine)
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for Android and Maps SDK for iOS
# Note: This is ONLY for the map rendering SDK, NOT for map data
# We use OpenStreetMap + Nominatim (Geocoding) + OSRM (Routing) for all map data
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
